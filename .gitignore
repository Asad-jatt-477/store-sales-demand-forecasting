# =============================================================================
# Retail Demand Forecasting System - Git ignore rules
# =============================================================================

# --- Python ------------------------------------------------------------------
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.venv/
venv/
env/

# --- Data --------------------------------------------------------------------
# Raw data is downloaded from Kaggle (Store Sales - Time Series Forecasting).
# train.csv exceeds GitHub's 100 MB file limit, and processed files are
# regenerated by the pipeline (src/01 - src/05).
data/raw/
data/processed/

# --- Pipeline caches ---------------------------------------------------------
# Intermediate backtest predictions; regenerated by phases 06 - 09.
reports/*_cache/

# --- Dashboard (Node.js / Next.js / Vercel) ----------------------------------
node_modules/
.next/
.vercel/
next-env.d.ts

# --- Logs and environment files ----------------------------------------------
*.log
.env
.env.*

# --- OS and editor files -----------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
